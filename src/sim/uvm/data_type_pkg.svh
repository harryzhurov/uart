    typedef logic [ 7:0] data8_t;
    typedef logic [15:0] data16_t;
    typedef logic [31:0] data32_t;

    typedef unsigned int      uint_t;
    typedef unsigned shortint ushort_t;
    typedef unsigned longint  ulong_t;

